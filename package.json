{
  "name": "sugar-mood",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n MOCK,WEB \"npm:mock\" \"npm:dev:web\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:web": "vite",
    "mock": "json-server --watch mock/db.json --host 127.0.0.1 --port 3001",
    "mock:reset": "node scripts/reset-mock.js",
    "test": "node --test"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "json-server": "^0.17.4",
    "vite": "^8.2.2"
  }
}
